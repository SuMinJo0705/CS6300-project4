class: "ChooseActionTest"

# Each line: Pacman's x,y | one belief per living ghost, separated by ";".
# A belief is "x,y=prob x,y=prob ...", and one that starts with "captured"
# belongs to a ghost that has already been caught.  The test calls your
# ExpectedDistanceBustersAgent.chooseAction with these beliefs (no inference
# involved) and checks the action it returns.  The cases tell the expected
# distance apart from chasing the most likely square, summing or maximizing
# over ghosts, the worst-case distance, Manhattan distance, tie-breaking,
# scoring captured ghosts, and leaving out Stop.
layout: """
%%%%%%%%%%%%%%%%%%%%
%                  %
% %%%%%%%% %%%%%%% %
%        %         %
%    P   %    %%%  %
%        %         %
%%%%%%%%%%%%%%%%%%%%
% % % % %%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%
"""

cases: """
5,4 | 8,4=0.4 1,3=0.2 1,4=0.2 1,5=0.2
5,4 | 2,4=0.5 2,3=0.5 ; 13,5=0.6 17,7=0.4
5,4 | 1,4=0.5 8,4=0.5 ; 5,7=1.0
5,4 | 1,4=0.9 17,3=0.1
8,4 | 11,4=1.0
8,4 | 10,7=0.5 11,3=0.5 ; 1,4=0.5 2,4=0.5
3,7 | 1,7=0.5 6,7=0.5
10,7 | 10,5=0.3 12,5=0.3 3,7=0.4
5,4 | captured 3,4=1.0 ; 8,4=1.0
5,4 | 5,5=0.25 5,3=0.25 6,4=0.25 4,4=0.25
"""
